#!/bin/sh

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

# Nothing is re-staged: no check writes to the working tree (see scripts/run-checks.mjs),
# so re-adding the staged paths could only commit edits the author left unstaged.

echo "✅ All pre-commit checks passed!"
