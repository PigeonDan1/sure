{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sure-eval.local/schemas/paper_claim.v1.json",
  "title": "SURE-EVAL paper claim evidence records",
  "$defs": {
    "PaperClaimCandidate": {
      "type": "object",
      "properties": {
        "paper_id": {"type": "string"},
        "paper_title": {"type": "string"},
        "source_pdf": {"type": "string"},
        "mineru_content_list": {"type": "string"},
        "table_id": {"type": "string"},
        "table_caption": {"type": "string"},
        "table_page_idx": {"type": ["integer", "null"]},
        "row_key": {"type": ["string", "null"]},
        "row_key_normalized": {"type": ["string", "null"]},
        "column_key": {"type": ["string", "null"]},
        "column_key_normalized": {"type": ["string", "null"]},
        "model_key": {"type": ["string", "null"]},
        "model_key_normalized": {"type": ["string", "null"]},
        "dataset_key": {"type": ["string", "null"]},
        "dataset_key_normalized": {"type": ["string", "null"]},
        "metric_key": {"type": ["string", "null"]},
        "metric_key_normalized": {"type": ["string", "null"]},
        "header_path": {"type": "array", "items": {"type": "string"}},
        "header_path_normalized": {"type": "array", "items": {"type": "string"}},
        "paper_value": {"type": ["number", "null"]},
        "paper_value_raw": {"type": "string"},
        "paper_value_unit": {"type": ["string", "null"]},
        "metric_direction": {"type": ["string", "null"]},
        "task": {"type": ["string", "null"]},
        "split": {"type": ["string", "null"]},
        "evidence_source": {"type": "string"},
        "evidence_text": {"type": "string"},
        "evidence_cell": {"type": "object"},
        "extraction_method": {"type": "string"},
        "key_match_status": {"type": "object"},
        "validation_status": {"type": "string"},
        "validation_method": {"type": "string"},
        "confidence": {"type": "string"},
        "needs_human_review": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "TableCellEvidence": {
      "type": "object",
      "properties": {
        "paper_id": {"type": "string"},
        "table_id": {"type": "string"},
        "table_caption": {"type": "string"},
        "page_idx": {"type": ["integer", "null"]},
        "row_index": {"type": "integer"},
        "col_index": {"type": "integer"},
        "cell_text": {"type": "string"},
        "cell_value_raw": {"type": ["string", "null"]},
        "cell_value": {"type": ["number", "null"]},
        "row_header_path": {"type": "array", "items": {"type": "string"}},
        "col_header_path": {"type": "array", "items": {"type": "string"}},
        "header_path": {"type": "array", "items": {"type": "string"}},
        "row_key_candidates": {"type": "array", "items": {"type": "string"}},
        "column_key_candidates": {"type": "array", "items": {"type": "string"}},
        "metric_key_candidates": {"type": "array", "items": {"type": "string"}},
        "dataset_key_candidates": {"type": "array", "items": {"type": "string"}},
        "model_key_candidates": {"type": "array", "items": {"type": "string"}},
        "normalized_tokens": {"type": "array", "items": {"type": "string"}},
        "evidence_source": {"type": "string"},
        "source_raw_table_hash": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
