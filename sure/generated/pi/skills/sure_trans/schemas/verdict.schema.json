{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["schema", "status", "model_name", "framework", "readiness", "validation", "artifacts"],
	"properties": {
		"schema": { "const": "sure.trans.verdict.v2" },
		"generated_at": { "type": "string" },
		"instance_id": { "type": "string" },
		"model_id": { "type": "string" },
		"model_name": { "type": "string" },
		"status": { "enum": ["pending", "passed", "success", "failed", "partial"] },
		"package": {
			"type": "object",
			"properties": {
				"profile": { "enum": ["none", "docker-local", "docker-registry"] }
			},
			"additionalProperties": true
		},
		"framework": {
			"type": "object",
			"required": ["computation", "model", "architecture_signals", "architecture_clarification"],
			"properties": {
				"computation": {
					"type": "object",
					"required": ["declared", "detected", "requirement_met"],
					"properties": {
						"declared": { "const": "pytorch" },
						"detected": { "const": "pytorch" },
						"requirement_met": { "const": true }
					},
					"additionalProperties": false
				},
				"model": {
					"type": "object",
					"required": ["declared", "detected", "matches", "transformers_preferred"],
					"properties": {
						"declared": { "type": "string", "minLength": 1 },
						"detected": { "enum": ["transformers", "custom"] },
						"matches": { "type": "boolean" },
						"transformers_preferred": { "const": true }
					},
					"additionalProperties": false
				},
				"architecture_signals": {
					"type": "array",
					"items": { "type": "string" },
					"uniqueItems": true
				},
				"architecture_clarification": { "type": ["string", "null"] }
			},
			"additionalProperties": false
		},
		"readiness": {
			"type": "object",
			"properties": {
				"local_ready": { "type": "boolean" },
				"docker_ready": { "type": "boolean" },
				"registry_ready": { "type": "boolean" },
				"bundle_ready": { "type": "boolean" },
				"vc_ready": { "type": ["boolean", "null"] }
			},
			"additionalProperties": true
		},
		"build": {
			"type": "object",
			"properties": { "success": { "type": "boolean" } },
			"additionalProperties": true
		},
		"validation": { "type": "object" },
		"artifacts": {
			"type": "object",
			"required": ["framework_detection"]
		}
	},
	"additionalProperties": true
}
