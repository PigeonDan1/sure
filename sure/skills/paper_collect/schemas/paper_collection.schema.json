{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sure.local/schemas/paper_collection.schema.json",
  "title": "Sure Paper Collection",
  "type": "object",
  "required": ["schema_version", "query", "target_count", "collected_count", "papers"],
  "properties": {
    "schema_version": { "const": "sure.paper_collection.v1" },
    "query": { "type": "string" },
    "target_count": { "type": "integer", "minimum": 1 },
    "collected_count": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string" },
    "sources": { "type": "array" },
    "deduplication": { "type": "object" },
    "files": { "type": "object" },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "authors", "year", "source", "source_rank", "dedupe_key", "download_status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "year": { "type": "integer" },
          "venue": { "type": "string" },
          "abstract": { "type": "string" },
          "url": { "type": "string" },
          "doi": { "type": "string" },
          "arxiv_id": { "type": "string" },
          "source": { "type": "string" },
          "source_rank": { "type": "integer" },
          "relevance_score": { "type": "number" },
          "download_status": { "type": "string" },
          "pdf_path": { "type": ["string", "null"] },
          "collection_reason": { "type": "string" },
          "dedupe_key": { "type": "string" },
          "metadata_path": { "type": "string" }
        }
      }
    }
  }
}
