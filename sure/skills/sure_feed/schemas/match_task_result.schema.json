{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "match_task_result.schema.json",
	"title": "SURE model-feed task match",
	"description": "Structured output of the MATCH_TASK unit. Each candidate carries a match with match_source provenance.",
	"type": "object",
	"required": ["candidates"],
	"properties": {
		"candidates": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["model_id", "match"],
				"properties": {
					"model_id": { "type": "string" },
					"match": {
						"type": "object",
						"required": ["matched"],
						"properties": {
							"matched": { "type": "boolean" },
							"match_source": {
								"type": "string",
								"description": "Strong or weak provenance such as tasks, pipeline_tag, model_card, readme, repo_topics, or custom_tag."
							},
							"task_type": { "type": "string" },
							"score": { "type": "number" },
							"evidence": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"source": { "type": "string", "enum": ["modelscope", "huggingface", "github", "manual", "local"] },
										"field": { "type": "string" },
										"value": {},
										"strength": { "type": "string", "enum": ["strong", "medium", "weak"] }
									},
									"additionalProperties": true
								}
							}
						},
						"additionalProperties": false
					}
				},
				"additionalProperties": true
			}
		}
	},
	"additionalProperties": false
}
