{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "load_result.schema.json",
	"title": "SURE model-tool load validation",
	"description": "Structured output of the VALIDATE_LOAD unit.",
	"type": "object",
	"required": ["load_passed"],
	"properties": {
		"load_passed": { "type": "boolean" },
		"duration_ms": { "type": "number" },
		"error": { "type": ["string", "null"] },
		"device": { "type": "string" },
		"resolved_device": { "type": ["string", "null"] },
		"declared_dtype": { "type": "string", "enum": ["bfloat16", "float16", "float32", "float64"] },
		"loaded_dtype": { "type": "string", "enum": ["bfloat16", "float16", "float32", "float64"] },
		"device_map": { "type": ["string", "null"] },
		"model_dir": { "type": "string" },
		"wrapper_path": { "type": "string" },
		"validate_py": { "type": "string" },
		"validate_args": { "type": "array", "items": { "type": "string" } },
		"run_command": { "type": ["array", "string"] },
		"cwd": { "type": "string" },
		"env": { "type": "object" },
		"log_path": { "type": "string" },
		"sample_output_path": { "type": "string" },
		"timeout_seconds": { "type": "number" },
		"executed": { "type": "boolean" }
	},
	"additionalProperties": false
}
