{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "package_gate.schema.json",
	"title": "SURE onboard package gate",
	"description": "Structured output of PACKAGE_GATE. It declares whether the required readiness target has been met for package=none, package=docker-local, or package=docker-registry. VC/HPC is intentionally not required by this gate.",
	"type": "object",
	"required": ["status", "package_profile", "readiness"],
	"properties": {
		"status": { "type": "string", "enum": ["passed", "failed", "blocked", "skipped"] },
		"package_profile": { "type": "string", "enum": ["none", "docker-local", "docker-registry"] },
		"readiness": {
			"type": "object",
			"required": ["local_ready"],
			"properties": {
				"local_ready": { "type": "boolean" },
				"docker_ready": { "type": "boolean" },
				"registry_ready": { "type": "boolean" },
				"vc_ready": { "type": ["boolean", "null"] }
			},
			"additionalProperties": false
		},
		"model_dir": { "type": "string" },
		"artifact_manifest_path": { "type": "string" },
		"local": {
			"type": "object",
			"properties": {
				"validation_passed": { "type": "boolean" },
				"artifacts_complete": { "type": "boolean" },
				"evidence": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": true
		},
		"docker": {
			"type": "object",
			"properties": {
				"build_passed": { "type": "boolean" },
				"validate_passed": { "type": "boolean" },
				"image_tag": { "type": "string" },
				"evidence": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": true
		},
		"registry": {
			"type": "object",
			"properties": {
				"push_passed": { "type": "boolean" },
				"pull_verify_passed": { "type": "boolean" },
				"image_tag": { "type": "string" },
				"evidence": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": true
		},
		"notes": { "type": "string" }
	},
	"additionalProperties": false
}
