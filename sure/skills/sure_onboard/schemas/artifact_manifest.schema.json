{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "artifact_manifest.schema.json",
	"title": "SURE model-tool artifact manifest",
	"description": "Structured output of the SAVE_ARTIFACTS unit. Indexes all artifacts landed under sure/models/<model_id>/. The artifacts object groups entries by category (required/conditional/optional); each entry records a path and a description.",
	"type": "object",
	"required": ["model_dir", "artifacts"],
	"properties": {
		"model_dir": { "type": "string", "description": "Resolved sure/models/<model_id>/ directory." },
		"instance_id": { "type": "string" },
		"timestamp": { "type": "string" },
		"model_id": { "type": "string" },
		"artifacts": {
			"type": "object",
			"required": ["required"],
			"properties": {
				"required": { "type": "object" },
				"conditional": { "type": "object" },
				"optional": { "type": "object" },
				"spec_path": { "type": "string" },
				"wrapper_path": { "type": "string" },
				"lockfile_path": { "type": ["string", "null"] },
				"log_path": { "type": "string" }
			},
			"additionalProperties": true
		}
	},
	"additionalProperties": false
}
