{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "model_input_resolved.schema.json",
	"title": "SURE onboard resolved MODEL_INPUT",
	"description": "Structured output of LOAD_MODEL_INPUT. It records the canonical MODEL_INPUT source, normalized model identity, target model directory, package profile, and user-facing run options.",
	"type": "object",
	"required": ["model_id", "model_name", "model_dir", "repo_url", "task_type", "deployment_type", "package_profile"],
	"properties": {
		"timestamp": { "type": "string" },
		"model_input_path": { "type": ["string", "null"] },
		"model_id": { "type": "string" },
		"model_name": { "type": "string" },
		"model_dir": { "type": "string" },
		"repo_url": { "type": "string" },
		"repo_commit": { "type": ["string", "null"] },
		"task_type": {
			"type": "string",
			"enum": ["asr", "s2tt", "sd", "ser", "tts", "vad", "vc", "kws", "slu", "gr", "speech_understanding", "sa-asr", "sa_asr"]
		},
		"deployment_type": { "type": "string", "enum": ["local", "api"] },
		"package_profile": { "type": "string", "enum": ["none", "docker-local", "docker-registry"] },
		"weights_link_policy": { "type": "string", "enum": ["auto", "copy", "symlink", "reuse-existing", "no-reuse"] },
		"force_repair": { "type": "boolean" },
		"existing_model_dir": { "type": ["string", "null"] },
		"skip_download": { "type": "boolean" },
		"device": { "type": "string", "enum": ["auto", "cuda", "cpu", "mps"] },
		"max_retries": { "type": "integer" },
		"cpu_fallback_after_cuda_failures": { "type": "integer" },
		"cuda_repair_attempts_before_cpu": { "type": "integer" },
		"device_policy": {
			"type": "object",
			"properties": {
				"requested_device": { "type": "string", "enum": ["auto", "cuda", "cpu", "mps"] },
				"cuda_first": { "type": "boolean" },
				"cpu_fallback_after_cuda_failures": { "type": "integer" },
				"cuda_repair_attempts_before_cpu": { "type": "integer" },
				"cpu_fallback_allowed": { "type": "boolean" }
			},
			"additionalProperties": true
		},
		"container_delivery": {
			"type": "object",
			"required": ["repository", "image_version", "target_image", "image_version_resolution"],
			"properties": {
				"repository": { "type": "string" },
				"image_version": { "type": "string" },
				"target_image": { "type": "string" },
				"image_version_resolution": { "type": "object" },
				"site_policy_path": { "type": ["string", "null"] },
				"site_policy_sha256": { "type": ["string", "null"] }
			},
			"additionalProperties": false
		},
		"path_policy": {
			"type": "object",
			"properties": {
				"model_dir_is_harness_owned": { "type": "boolean" },
				"model_dir_symlink_allowed": { "type": "boolean" },
				"allowed_model_root": { "type": "string" },
				"asset_symlink_policy": { "type": "string" }
			},
			"additionalProperties": true
		},
		"source": {
			"type": "object",
			"properties": {
				"handoff_dir": { "type": ["string", "null"] },
				"handoff_artifacts_dir": { "type": ["string", "null"] },
				"raw_args": { "type": "string" }
			},
			"additionalProperties": true
		},
		"normalized_model_input": { "type": "object" }
	},
	"additionalProperties": false
}
