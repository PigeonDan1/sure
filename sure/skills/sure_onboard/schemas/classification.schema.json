{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "classification.schema.json",
	"title": "SURE model-tool classification",
	"description": "Structured output of the CLASSIFY unit.",
	"type": "object",
	"required": ["task_type"],
	"properties": {
		"task_type": {
			"type": "string",
			"enum": ["asr", "classification", "gr", "kws", "s2tt", "sa_asr", "sd", "se", "ser", "slu", "sv", "tse", "tts", "vad", "vc", "sa-asr", "saasr", "speech-enhancement", "speech_enhancement", "speech_understanding"]
		},
		"deployment_type": { "type": "string", "enum": ["local", "api"] },
		"sub_task": { "type": "string" },
		"input_modality": { "type": "string" },
		"output_modality": { "type": "string" },
		"rationale": { "type": "string" }
	},
	"additionalProperties": false
}
