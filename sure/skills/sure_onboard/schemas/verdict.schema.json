{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "verdict.schema.json",
	"title": "SURE model-tool verdict",
	"description": "Structured output of the VERDICT unit. A success status requires build.success, all four validation tests passed, and readiness semantics consistent with package_profile. The schema intentionally allows richer upstream-style terminal evidence; check_verdict.py owns semantic validation.",
	"type": "object",
	"required": ["status"],
	"properties": {
		"instance_id": { "type": "string" },
		"timestamp": { "type": "string" },
		"model_id": { "type": "string" },
		"model_name": { "type": "string" },
		"status": { "type": "string", "enum": ["pending", "passed", "success", "failed", "partial", "PASS", "PASSED", "FAIL"] },
		"phase": { "type": "string" },
		"tool_ready": { "type": "boolean" },
		"package": {
			"type": "object",
			"properties": {
				"profile": { "type": "string", "enum": ["none", "docker-local", "docker-registry"] }
			},
			"additionalProperties": true
		},
		"readiness": {
			"type": "object",
			"properties": {
				"local_ready": { "type": "boolean" },
				"docker_ready": { "type": "boolean" },
				"registry_ready": { "type": "boolean" },
				"bundle_ready": { "type": "boolean" },
				"vc_ready": { "type": ["boolean", "null"] }
			},
			"additionalProperties": true
		},
		"backend": {
			"type": "object",
			"properties": {
				"type": { "type": "string" },
				"choice_reason": { "type": "string" }
			},
			"additionalProperties": false
		},
		"build": {
			"type": "object",
			"required": ["success"],
			"properties": {
				"success": { "type": "boolean" },
				"duration_seconds": { "type": "number" },
				"log_path": { "type": "string" }
			},
			"additionalProperties": false
		},
		"validation": {
			"type": "object",
			"properties": {
				"import_test": { "$ref": "#/$defs/testResult" },
				"load_test": { "$ref": "#/$defs/testResult" },
				"infer_test": { "$ref": "#/$defs/testResult" },
				"contract_test": { "$ref": "#/$defs/testResult" }
			},
			"additionalProperties": false
		},
		"failure": {
			"type": "object",
			"properties": {
				"type": { "type": ["string", "null"] },
				"category": { "type": ["string", "null"] },
				"message": { "type": ["string", "null"] },
				"retryable": { "type": "boolean" }
			},
			"additionalProperties": false
		},
		"artifacts": {
			"type": "object",
			"properties": {
				"spec_path": { "type": "string" },
				"wrapper_path": { "type": "string" },
				"lockfile_path": { "type": ["string", "null"] },
				"log_path": { "type": "string" },
				"artifact_manifest_path": { "type": "string" },
				"validation_log_path": { "type": "string" },
				"sample_output_path": { "type": "string" }
			},
			"additionalProperties": true
		},
		"notes": { "type": "string" }
	},
	"$defs": {
		"testResult": {
			"type": "object",
			"required": ["passed"],
			"properties": {
				"passed": { "type": "boolean" },
				"duration_ms": { "type": "number" },
				"error": { "type": ["string", "null"] }
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": true
}
