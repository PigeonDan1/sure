{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "wrapper_manifest.schema.json",
	"title": "SURE model-tool wrapper manifest",
	"description": "Structured output of the GENERATE_WRAPPER unit.",
	"type": "object",
	"required": ["wrapper_path"],
	"properties": {
		"wrapper_path": { "type": "string", "description": "Directory containing model.py/server.py/__init__.py/validate.py" },
		"model_py": { "type": "string" },
		"server_py": { "type": "string" },
		"init_py": { "type": "string" },
		"validate_py": { "type": "string" },
		"config_yaml": { "type": "string" }
	},
	"additionalProperties": false
}
