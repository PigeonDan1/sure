{
	"name": "sure_onboard",
	"command": "/sure_onboard",
	"description": "Onboard or repair an audio model into a reproducible local inference unit: discover the repo, classify, plan a backend, build the environment, fetch weights, validate import/load/infer/contract, generate the wrapper, and save artifacts with a verdict.",
	"prompt": "SKILL.md",
	"hooks": {
		"pre_start": [{ "module": "hooks/index.ts", "handler": "preStart" }],
		"pre_tool_call": [{ "module": "hooks/index.ts", "handler": "preToolCall" }],
		"post_tool_result": [{ "module": "hooks/index.ts", "handler": "postToolResult" }],
		"pre_finish": [{ "module": "hooks/index.ts", "handler": "preFinish" }],
		"post_finish": [{ "module": "hooks/index.ts", "handler": "postFinish" }],
		"on_error": [{ "module": "hooks/index.ts", "handler": "onError" }]
	},
	"artifacts": [
		{
			"type": "verdict",
			"path": "artifacts/verdict.json",
			"required": true,
			"description": "Final SURE-EVAL model-tool verdict (verdict.json)."
		},
		{
			"type": "model_spec",
			"required": false,
			"description": "Model specification (model.spec.yaml)."
		},
		{
			"type": "wrapper",
			"required": false,
			"description": "Generated wrapper file set (model.py, server.py, __init__.py, validate.py)."
		}
	],
	"ui": {
		"primaryCounters": ["completed_units", "total_units", "gate_blocks"],
		"artifactTypes": ["verdict", "model_spec", "wrapper", "artifact_manifest"],
		"defaultExpandedSections": ["diagnostics", "artifacts"]
	}
}
