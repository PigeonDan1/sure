{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["status", "baseline_output", "adapter_output", "run_command"],
	"properties": {
		"status": { "enum": ["pending", "passed", "failed"] },
		"baseline_output": { "type": "string" },
		"adapter_output": { "type": "string" },
		"comparison_policy": { "enum": ["exact", "normalized_whitespace", "vector_allclose"] },
		"rtol": { "type": "number", "minimum": 0 },
		"atol": { "type": "number", "minimum": 0 },
		"comparison_evidence": { "type": "object" },
		"run_command": { "type": ["array", "string"] },
		"cwd": { "type": "string" },
		"env": { "type": "object" },
		"timeout_seconds": { "type": "number", "minimum": 1 },
		"equivalent": { "type": "boolean" },
		"executed": { "type": "boolean" },
		"exit_code": { "type": "integer" },
		"duration_ms": { "type": "number" },
		"log_path": { "type": "string" },
		"selected_device": { "enum": ["cuda", "cpu"] },
		"error": { "type": ["string", "null"] }
	},
	"additionalProperties": true
}
