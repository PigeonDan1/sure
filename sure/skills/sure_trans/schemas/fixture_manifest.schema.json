{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"schema",
		"status",
		"model_id",
		"model_name",
		"model_dir",
		"task_type",
		"source_dir",
		"staged_dir",
		"gt_jsonl",
		"samples",
		"source_path",
		"staged_path",
		"sha256",
		"gt_sha256",
		"size_bytes",
		"sample_count",
		"link_policy",
		"annotation_source"
	],
	"properties": {
		"schema": { "const": "sure.trans.fixture_manifest.v1" },
		"status": { "const": "ready" },
		"model_id": { "type": "string" },
		"model_name": { "type": "string" },
		"model_dir": { "type": "string" },
		"task_type": { "enum": ["asr", "s2tt", "sv", "tts", "vc"] },
		"source_dir": { "type": "string" },
		"staged_dir": { "type": "string" },
		"gt_jsonl": { "type": "string" },
		"samples": {
			"type": "array",
			"minItems": 1,
			"maxItems": 5,
			"items": {
				"type": "object",
				"required": ["key", "audio", "audio_path", "annotation_fields"],
				"properties": {
					"key": { "type": "string" },
					"audio": { "type": "string" },
					"audio_path": { "type": "string" },
					"annotation_fields": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string" }
					},
					"speaker_id": { "type": "string" },
					"trial_manifest": { "type": "string" }
				},
				"additionalProperties": true
			}
		},
		"source_path": { "type": "string" },
		"staged_path": { "type": "string" },
		"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"gt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"trial_manifest": { "type": "string" },
		"trial_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"trials_file": { "type": "string" },
		"trials_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"provenance": { "type": "string" },
		"provenance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"size_bytes": { "type": "integer", "minimum": 1 },
		"sample_count": { "type": "integer", "minimum": 1, "maximum": 5 },
		"link_policy": { "const": "copy" },
		"annotation_source": {
			"type": "object",
			"required": ["type", "source_path", "staged_path", "fallback"],
			"properties": {
				"type": { "enum": ["fixture_expected_sidecar", "task_registry_fixture"] },
				"source_path": { "type": "string" },
				"staged_path": { "type": "string" },
				"bundled_path": { "type": "string" },
				"fallback": { "const": false }
			},
			"additionalProperties": false
		}
	},
	"allOf": [
		{
			"if": { "properties": { "task_type": { "const": "sv" } }, "required": ["task_type"] },
			"then": {
				"required": [
					"trial_manifest",
					"trial_manifest_sha256",
					"trials_file",
					"trials_sha256",
					"provenance",
					"provenance_sha256"
				],
				"properties": {
					"annotation_source": {
						"properties": { "type": { "const": "task_registry_fixture" } }
					}
				}
			},
			"else": {
				"required": ["expected_sha256"],
				"properties": {
					"samples": { "maxItems": 1 },
					"sample_count": { "const": 1 },
					"annotation_source": {
						"properties": { "type": { "const": "fixture_expected_sidecar" } }
					}
				}
			}
		}
	],
	"additionalProperties": true
}
