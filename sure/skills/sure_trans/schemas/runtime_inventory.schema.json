{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["schema", "generated_at", "status", "model", "local_runtime", "model_runtime", "harness_runtime", "container_runtime", "weights", "readiness", "evidence", "policy"],
	"properties": {
		"schema": { "const": "sure.onboard.runtime_inventory.v2" },
		"generated_at": { "type": "string" },
		"status": { "const": "ready" },
		"model": { "type": "object" },
		"local_runtime": { "type": "object" },
		"model_runtime": { "type": "object" },
		"harness_runtime": { "type": "object" },
		"container_runtime": { "type": "object" },
		"weights": { "type": "object" },
		"readiness": { "type": "object" },
		"evidence": { "type": ["array", "object"] },
		"policy": {
			"type": "object",
			"required": ["eval_runtime", "host_python_fallback", "image_override_allowed"],
			"properties": {
				"eval_runtime": { "enum": ["container_only", "python"] },
				"host_python_fallback": { "const": false },
				"image_override_allowed": { "const": false }
			},
			"additionalProperties": true
		}
	},
	"allOf": [
		{
			"if": { "properties": { "policy": { "properties": { "eval_runtime": { "const": "container_only" } } } } },
			"then": { "properties": { "container_runtime": { "required": ["required", "target_image_digest", "target_image_ref", "working_dir", "server_command", "tool_names", "gpu_required", "mount_policy"], "properties": { "required": { "const": true } } } } },
			"else": { "properties": { "container_runtime": { "required": ["required"], "properties": { "required": { "const": false } } }, "model_runtime": { "required": ["required", "runtime_id", "backend", "python_executable", "manifest_path", "server_command"] } } }
		}
	],
	"additionalProperties": true
}
