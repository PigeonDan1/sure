{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScholarProfileManifest",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "inputs", "outputs", "validation", "artifacts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "partial", "error"] },
    "inputs": {
      "type": "object",
      "required": ["scholar_name"],
      "properties": {
        "scholar_name": { "type": "string" },
        "native_name": { "type": ["string", "null"] },
        "seed_url": { "type": ["string", "null"] },
        "language": { "type": "string", "enum": ["en", "zh"] }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "system_prompt": { "type": "string" },
        "system_prompt_docx": { "type": "string" },
        "scholar_csv": { "type": "string" },
        "source_urls": { "type": "string" },
        "mainline_json": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "system_prompt_words": { "type": "integer" },
        "total_papers": { "type": "integer" },
        "sources_scraped": { "type": "integer" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "type"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
