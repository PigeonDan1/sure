{
  "name": "scholar_profile",
  "command": "/scholar_profile",
  "description": "Extract scholar profile from DBLP, OpenAlex, Google Scholar, and personal pages — generate structured system prompt for persona simulation.",
  "prompt": "SKILL.md",
  "hooks": {
    "pre_start": [{ "module": "hooks/index.ts", "handler": "preStart" }],
    "pre_tool_call": [{ "module": "hooks/index.ts", "handler": "preToolCall" }],
    "post_tool_result": [{ "module": "hooks/index.ts", "handler": "postToolResult" }],
    "pre_finish": [{ "module": "hooks/index.ts", "handler": "preFinish" }],
    "post_finish": [{ "module": "hooks/index.ts", "handler": "postFinish" }],
    "on_error": [{ "module": "hooks/index.ts", "handler": "onError" }]
  },
  "artifacts": [
    {
      "type": "system_prompt",
      "path": "system_prompt.md",
      "required": true,
      "description": "Generated system prompt for persona simulation"
    },
    {
      "type": "system_prompt_docx",
      "path": "system_prompt.docx",
      "required": false,
      "description": "Word document version of the system prompt"
    },
    {
      "type": "scholar_csv",
      "path": "scholars.csv",
      "required": true,
      "description": "Scholar metadata from DBLP"
    },
    {
      "type": "source_urls",
      "path": "source_urls.json",
      "required": true,
      "description": "Discovered web sources"
    },
    {
      "type": "mainline_graph",
      "path": "mainline.json",
      "required": true,
      "description": "Research mainline graph"
    },
    {
      "type": "manifest",
      "path": "manifest.json",
      "required": true,
      "description": "Run manifest with validation results"
    }
  ],
  "ui": {
    "primaryCounters": ["completed_stages", "total_stages"],
    "artifactTypes": ["system_prompt", "scholar_csv", "source_urls", "mainline_graph", "manifest"],
    "defaultExpandedSections": ["artifacts", "diagnostics"]
  }
}
