{
	"name": "sure_eval",
	"command": "/sure_eval",
	"description": "Orchestrate a SURE-EVAL evaluation run for an already-onboarded audio model: classify the task, route to deterministic scripts, materialize and gate the execution surface, submit via vc, assess results, and write the run report.",
	"prompt": "SKILL.md",
	"hooks": {
		"pre_start": [{ "module": "hooks/index.ts", "handler": "preStart" }],
		"pre_tool_call": [{ "module": "hooks/index.ts", "handler": "preToolCall" }],
		"post_tool_result": [{ "module": "hooks/index.ts", "handler": "postToolResult" }],
		"pre_finish": [{ "module": "hooks/index.ts", "handler": "preFinish" }],
		"post_finish": [{ "module": "hooks/index.ts", "handler": "postFinish" }],
		"on_error": [{ "module": "hooks/index.ts", "handler": "onError" }]
	},
	"artifacts": [
		{
			"type": "run_report",
			"path": "artifacts/main_agent_run_report.json",
			"required": true,
			"description": "Final SURE-EVAL main-flow run report (main_agent_run_report.json)."
		},
		{
			"type": "execution_surface",
			"path": "artifacts/execution_surface.json",
			"required": true,
			"description": "Materialized execution surface artifact (execution_surface.json) with template source provenance."
		},
		{
			"type": "model_eval_manifest",
			"required": false,
			"description": "Optional aligned model evaluation manifest (model_eval_manifest.json)."
		}
	],
	"ui": {
		"primaryCounters": ["completed_units", "total_units", "gate_blocks"],
		"artifactTypes": ["run_report", "execution_surface", "model_eval_manifest"],
		"defaultExpandedSections": ["diagnostics", "artifacts"]
	}
}
