{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "execution_result.schema.json",
	"title": "SURE-EVAL execute & wait result",
	"description": "Structured output of the EXECUTE_WAIT_UNIT.",
	"type": "object",
	"required": ["job_status"],
	"properties": {
		"job_status": {
			"type": "string",
			"enum": ["succeeded", "running", "failed", "partial"]
		},
		"vc_job_id": { "type": "string" },
		"execution_path": { "type": "string", "enum": ["vc_submit", "local_bash", "local_docker", "local_python"] },
		"runtime_kind": { "type": "string", "enum": ["container", "python"] },
		"execution_requested": { "type": "string", "enum": ["auto", "local", "vc"] },
		"predictions_path": { "type": "string" },
		"log_path": { "type": "string" },
		"host": { "type": "string" },
		"pid": { "type": "number" },
		"command": { "type": "string" },
		"cwd": { "type": "string" },
		"started_at": { "type": "string" },
		"ended_at": { "type": "string" },
		"duration_seconds": { "type": "number" },
		"exit_code": { "type": "number" },
		"stdout_log": { "type": "string" },
		"stderr_log": { "type": "string" },
		"device_request": { "type": "string" },
		"device_actual": { "type": "string" },
		"cuda_visible_devices": { "type": "string" },
		"completion_source": {
			"type": "string",
			"enum": ["terminal_sentinel", "vc_terminal_without_sentinel", "wait_timeout", "local_process"]
		},
		"submission_token": { "type": "string" },
		"terminal_sentinel": { "type": "string" },
		"timed_out": { "type": "boolean" },
		"poll_count": { "type": "integer", "minimum": 0 },
		"vc_info_excerpt": { "type": "string" },
		"vc_describe_excerpt": { "type": "string" },
		"next_action": { "type": "string" }
	},
	"additionalProperties": false
}
