{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "submit_result.schema.json",
	"title": "SURE-EVAL execution submit result",
	"description": "Structured output of the SUBMIT_EXECUTION_UNIT for either local or vc execution.",
	"type": "object",
	"required": ["execution_path", "vc_available"],
	"properties": {
		"execution_path": {
			"type": "string",
			"enum": ["vc_submit", "local_bash", "local_docker", "local_python"]
		},
		"runtime_kind": { "type": "string", "enum": ["container", "python"] },
		"vc_available": {
			"type": "boolean",
			"description": "Legacy flag kept for the transitional submit_result.json; always false now that VC submission is gone."
		},
		"vc_job_id": { "type": "string" },
		"vc_info": { "type": "string" },
		"execution_requested": { "type": "string", "enum": ["auto", "local", "vc"] },
		"execution": { "type": "object", "additionalProperties": true },
		"fallback_approved": { "type": "boolean" },
		"local_fallback_reason": { "type": "string" },
		"submitted_at": { "type": "string" },
		"submission_token": { "type": "string" },
		"terminal_status_path": { "type": "string" },
		"host": { "type": "string" },
		"pid": { "type": "number" },
		"command": { "type": "string" },
		"cwd": { "type": "string" },
		"device_request": { "type": "string" },
		"device_actual": { "type": "string" },
		"cuda_visible_devices": { "type": "string" },
		"stdout_log": { "type": "string" },
		"stderr_log": { "type": "string" },
		"vc_submit_command": { "type": "string" },
		"vc_partition": { "type": "string" },
		"vc_mem": { "type": "string" },
		"vc_gpu": { "type": "number" },
		"vc_cpu": { "type": "number" },
		"vc_image": { "type": "string" },
		"image_digest": { "type": "string" },
		"image_identity_ref": { "type": "string" },
		"deployment_binding": { "type": "object", "additionalProperties": true },
		"harness_runtime": { "type": "object", "additionalProperties": true },
		"harness_runtime_mounted_from_repo": { "type": "boolean" },
		"model_runtime": { "type": "object", "additionalProperties": true },
		"evaluation_runtime": {
			"type": ["object", "null"],
			"description": "The Evaluation Runtime binding the host injected into this submission, or null when the run has none. The SUBMIT_EXECUTION gate resolves one independently and reports a disagreement.",
			"additionalProperties": true
		},
		"surface_env_refused": {
			"type": "array",
			"description": "Variables the execution surface asked for that the run does not decide: PATH, the loader and interpreter variables, GIT_*, and the SURE_EVALUATION_*/SURE_HARNESS_* bindings.",
			"items": { "type": "string" }
		},
		"vc_submission": {
			"type": "object",
			"description": "Effective VC submission snapshot mirrored into execution_surface.vc_runtime.resolved_submission.",
			"additionalProperties": true
		}
	},
	"additionalProperties": false
}
