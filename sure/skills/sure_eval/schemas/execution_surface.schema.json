{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "execution_surface.schema.json",
	"title": "SURE-EVAL execution surface",
	"description": "Structured output of the EXECUTION_SURFACE_UNIT. Compatible with the read-only main-flow execution-surface template while preserving the harness entrypoint field.",
	"type": "object",
	"required": ["source_provenance", "deployment_binding"],
	"properties": {
		"run_id": { "type": "string" },
		"timestamp": { "type": "string" },
		"execution_surface_type": { "type": "string" },
		"materialized": { "type": "boolean" },
		"entrypoint": {
			"type": "string",
			"description": "Harness-compatible path to the materialized run_evaluation.sh."
		},
		"entrypoint_path": {
			"type": "string",
			"description": "Main-flow-compatible path to the materialized run_evaluation.sh."
		},
		"entrypoint_path_actual": { "type": "string" },
		"execution": { "type": "object", "additionalProperties": true },
		"deployment_binding": {
			"type": "object",
			"required": ["schema", "runtime_kind", "execution_mode", "model_mount_read_only", "result_mount_writable"],
			"properties": {
				"schema": { "const": "sure.eval.deployment_binding.v1" },
				"runtime_kind": { "enum": ["python", "container"] },
				"target_image_ref": { "type": ["string", "null"], "pattern": "@sha256:[0-9a-f]{64}$" },
				"model_python": { "type": ["string", "null"] },
				"bundle_identity_sha256": { "type": ["string", "null"] },
				"execution_mode": { "enum": ["python", "container_only"] },
				"model_mount_read_only": { "const": true },
				"result_mount_writable": { "const": true }
			},
			"additionalProperties": false
		},
		"inference_runtime": {
			"type": "object",
			"properties": {
				"required_imports": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Python modules that must import successfully in MODEL_PYTHON before local execution is approved."
				},
				"import_probe_policy": {
					"type": "string",
					"enum": ["declared_only", "skip", "required"],
					"description": "declared_only is the default: imports are hard-gated only when required_imports is declared."
				}
			},
			"additionalProperties": true
		},
		"evaluation_runtime": { "type": "object", "additionalProperties": true },
		"vc_runtime": { "type": "object", "additionalProperties": true },
		"generation_method": { "type": "string" },
		"source_provenance": {
			"type": "object",
			"required": ["template_file"],
			"properties": {
				"template_file": {
					"type": "string",
					"description": "Declared template file used to materialize the execution surface."
				},
				"template_sha256": { "type": "string" },
				"source_template_file": { "type": "string" },
				"source_template_sha256": { "type": "string" },
				"mirror_template_file": { "type": "string" },
				"mirror_template_sha256": { "type": "string" },
				"files_read_during_generation": { "type": "array", "items": { "type": "string" } },
				"isolation_compliance": {
					"type": "object",
					"properties": {
						"eval_runs_referenced": { "type": "boolean" },
						"prior_run_scripts_copied": { "type": "boolean" },
						"template_parameters_deviated": { "type": "array", "items": { "type": "string" } },
						"deviation_approved_by_user": { "type": "boolean" }
					},
					"additionalProperties": true
				},
				"materialized_at": { "type": "string" }
			},
			"additionalProperties": false
		},
		"resolved_inputs": {
			"type": "object",
			"properties": {
				"model_dir": { "type": "string" },
				"tool_name": { "type": "string" }
			},
			"additionalProperties": true
		},
		"expected_outputs": { "type": "object", "additionalProperties": true },
		"commands": { "type": "array", "items": { "type": "string" } },
		"env": { "type": "object", "additionalProperties": { "type": "string" } },
		"reason": { "type": "string" },
		"notes": { "type": "array", "items": { "type": "string" } }
	},
	"additionalProperties": false
}
