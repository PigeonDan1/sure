{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "reval_run_report.schema.json",
	"title": "SURE re-evaluation run report",
	"type": "object",
	"required": ["schema", "run_id", "run_dir", "evaluation_only", "old_evaluation_reused", "artifacts", "summary"],
	"properties": {
		"schema": { "type": "string", "enum": ["sure.reval.run_report.v1"] },
		"run_id": { "type": "string" },
		"run_dir": { "type": "string" },
		"model_name": { "type": "string" },
		"datasets": { "type": "array", "items": { "type": "string" } },
		"metrics": { "type": "array", "items": { "type": "string" } },
		"pipeline_ids": { "type": "array", "items": { "type": "string" } },
		"evaluation_only": { "type": "boolean" },
		"old_evaluation_reused": { "type": "boolean" },
		"artifacts": { "type": "object", "additionalProperties": { "type": "string" } },
		"summary": { "type": "object", "additionalProperties": true }
	},
	"additionalProperties": false
}
