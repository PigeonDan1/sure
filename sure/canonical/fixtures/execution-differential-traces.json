{
	"schema": "sure.execution.differential_traces.v1",
	"version": 1,
	"description": "Canonical execution outcome projections shared by surectl and the Pi registered-operation facade.",
	"rules": {
		"execution_success_requires_independent_validation": true,
		"pi_facade_emits_request_receipt": false,
		"capability_missing_must_not_pass": true
	},
	"cases": [
		{
			"id": "invalid_contract",
			"class": "structural_error",
			"canonical": {
				"receipt_lifecycle": "NOT_STARTED",
				"validator_verdict": "NOT_EXECUTED",
				"workflow_disposition": "BLOCK",
				"outcome": "NOT_EXECUTED",
				"reason_code": "INVALID_CONTRACT"
			},
			"surectl": {
				"evidence_verdict": "NOT_EXECUTED",
				"evidence_reason_code": "INVALID_CONTRACT",
				"receipt_lifecycle": "NOT_STARTED",
				"receipt_valid": false,
				"capability_admitted": false,
				"request_receipt": "present",
				"assurance_profile": "cooperative"
			},
			"pi": {
				"evidence_verdict": "NOT_EXECUTED",
				"evidence_reason_code": "INVALID_CONTRACT",
				"request_receipt": "absent",
				"assurance_profile": "hook_enforced"
			},
			"relation": "semantic_equal_assurance_different"
		},
		{
			"id": "capability_missing",
			"class": "capability_absent",
			"canonical": {
				"receipt_lifecycle": "NOT_STARTED",
				"validator_verdict": "NOT_EXECUTED",
				"workflow_disposition": "BLOCK",
				"outcome": "NOT_EXECUTED",
				"reason_code": "CAPABILITY_MISSING"
			},
			"surectl": {
				"evidence_verdict": "NOT_EXECUTED",
				"evidence_reason_code": "CAPABILITY_MISSING",
				"receipt_lifecycle": "NOT_STARTED",
				"receipt_valid": false,
				"capability_admitted": false,
				"request_receipt": "present",
				"assurance_profile": "cooperative"
			},
			"pi": {
				"evidence_verdict": "NOT_EXECUTED",
				"evidence_reason_code": "CAPABILITY_MISSING",
				"request_receipt": "absent",
				"assurance_profile": "hook_enforced"
			},
			"relation": "semantic_equal_assurance_different"
		},
		{
			"id": "executor_failed",
			"class": "nonzero_exit",
			"canonical": {
				"receipt_lifecycle": "FAILED",
				"validator_verdict": "FAIL",
				"workflow_disposition": "RETRY",
				"outcome": "RETRY",
				"reason_code": "EXECUTION_FAILED"
			},
			"surectl": {
				"evidence_verdict": "FAIL",
				"evidence_reason_code": "EXECUTION_FAILED",
				"receipt_lifecycle": "FAILED",
				"receipt_valid": true,
				"capability_admitted": true,
				"request_receipt": "present",
				"assurance_profile": "cooperative"
			},
			"pi": {
				"evidence_verdict": "FAIL",
				"evidence_reason_code": "EXECUTION_FAILED",
				"request_receipt": "absent",
				"assurance_profile": "hook_enforced"
			},
			"relation": "semantic_equal_assurance_different"
		},
		{
			"id": "partial_output",
			"class": "partial_output",
			"canonical": {
				"receipt_lifecycle": "PARTIAL",
				"validator_verdict": "FAIL",
				"workflow_disposition": "BLOCK",
				"outcome": "BLOCKED",
				"reason_code": "EXECUTION_PARTIAL"
			},
			"surectl": {
				"evidence_verdict": "FAIL",
				"evidence_reason_code": "EXECUTION_PARTIAL",
				"receipt_lifecycle": "PARTIAL",
				"receipt_valid": true,
				"capability_admitted": true,
				"request_receipt": "present",
				"assurance_profile": "cooperative"
			},
			"pi": {
				"evidence_verdict": "NOT_EXECUTED",
				"evidence_reason_code": "INVALID_CONTRACT",
				"request_receipt": "absent",
				"assurance_profile": "hook_enforced"
			},
			"relation": "explicit_facade_assurance_gap",
			"note": "The Pi compatibility facade has no output-contract receipt. A zero-exit callback that leaves no regular gate artifact remains INVALID_CONTRACT, preserving its legacy semantics; it is not evidence of a trusted partial executor run."
		},
		{
			"id": "execution_succeeded_validation_pending",
			"class": "successful_execution_before_validator",
			"canonical": {
				"receipt_lifecycle": "SUCCEEDED",
				"validator_verdict": "NOT_EXECUTED",
				"workflow_disposition": "WAIT",
				"outcome": "NOT_EXECUTED",
				"reason_code": "VALIDATION_PENDING"
			},
			"surectl": {
				"evidence_verdict": "PASS",
				"evidence_reason_code": "EXECUTION_SUCCEEDED",
				"receipt_lifecycle": "SUCCEEDED",
				"receipt_valid": true,
				"capability_admitted": true,
				"request_receipt": "present",
				"assurance_profile": "cooperative"
			},
			"pi": {
				"evidence_verdict": "PASS",
				"evidence_reason_code": "EXECUTION_SUCCEEDED",
				"request_receipt": "absent",
				"assurance_profile": "hook_enforced"
			},
			"relation": "semantic_equal_assurance_different"
		}
	]
}
