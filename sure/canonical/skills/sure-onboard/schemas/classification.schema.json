{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "classification.schema.json",
	"title": "SURE model-tool classification",
	"description": "Structured output of the CLASSIFY unit.",
	"type": "object",
	"required": ["task_type"],
	"properties": {
		"task_type": {
			"type": "string",
			"enum": ["asr", "s2tt", "sd", "ser", "tts", "vc", "kws", "slu", "gr", "speech_understanding", "sa-asr", "sa_asr"]
		},
		"deployment_type": { "type": "string", "enum": ["local", "api"] },
		"sub_task": { "type": "string" },
		"input_modality": { "type": "string" },
		"output_modality": { "type": "string" },
		"rationale": { "type": "string" }
	},
	"additionalProperties": false
}
