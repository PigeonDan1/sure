{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sure.example/contracts/portable-runtime-lock.v1.schema.json",
	"title": "SURE portable runtime lock",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"runtime_version",
		"core_package_version",
		"semantic_backend_registry_digest",
		"executor_registry_digest",
		"operation_ids",
		"files",
		"runtime_digest"
	],
	"properties": {
		"schema": { "const": "sure.portable.runtime.lock.v1" },
		"runtime_version": { "const": "portable-v1" },
		"core_package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
		"semantic_backend_registry_digest": { "$ref": "#/$defs/digest" },
		"executor_registry_digest": { "$ref": "#/$defs/digest" },
		"operation_ids": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "pattern": "^sure\\.[a-z0-9][a-z0-9._-]+$" }
		},
		"files": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "size_bytes", "sha256"],
				"properties": {
					"path": {
						"type": "string",
						"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
					},
					"size_bytes": { "type": "integer", "minimum": 0 },
					"sha256": { "$ref": "#/$defs/digest" }
				}
			}
		},
		"runtime_digest": { "$ref": "#/$defs/digest" }
	},
	"$defs": {
		"digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
	}
}
