{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sure.example/contracts/execution-request.v1.schema.json",
	"title": "SURE execution request",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"request_id",
		"semantic_request_digest",
		"run_id",
		"unit_id",
		"attempt",
		"operation",
		"subject",
		"inputs",
		"entrypoint",
		"runtime_requirements",
		"capability_requirements",
		"reference_snapshot_digest",
		"output_root",
		"policy_digest",
		"created_at"
	],
	"properties": {
		"schema": { "const": "sure.execution_request.v1" },
		"request_id": { "$ref": "#/$defs/id" },
		"semantic_request_digest": { "$ref": "#/$defs/digest" },
		"run_id": { "$ref": "#/$defs/id" },
		"unit_id": { "$ref": "#/$defs/id" },
		"attempt": { "type": "integer", "minimum": 1 },
		"operation": { "enum": ["validation", "inference", "formal_evaluation", "package", "publication"] },
		"subject": {
			"type": "object",
			"additionalProperties": false,
			"required": ["bundle_manifest_path", "bundle_digest", "runtime_identity_digest"],
			"properties": {
				"bundle_manifest_path": { "$ref": "#/$defs/absolutePath" },
				"bundle_digest": { "$ref": "#/$defs/digest" },
				"runtime_identity_digest": { "$ref": "#/$defs/digest" },
				"inference_protocol_digest": { "$ref": "#/$defs/digest" },
				"dataset_identity_digest": { "$ref": "#/$defs/digest" },
				"scoring_protocol_digest": { "$ref": "#/$defs/digest" }
			}
		},
		"inputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
		"input_binding": { "$ref": "#/$defs/inputBinding" },
		"entrypoint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["executable", "argv"],
			"properties": {
				"executable": { "type": "string", "minLength": 1 },
				"argv": { "type": "array", "items": { "type": "string" } },
				"working_directory": { "$ref": "#/$defs/absolutePath" }
			}
		},
		"runtime_requirements": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
		"capability_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
		"reference_snapshot_digest": { "$ref": "#/$defs/digest" },
		"output_root": { "$ref": "#/$defs/outputRoot" },
		"policy_digest": { "$ref": "#/$defs/digest" },
		"created_at": { "type": "string", "format": "date-time" },
		"output_contract": { "$ref": "#/$defs/outputContract" }
	},
	"allOf": [
		{
			"if": {
				"properties": { "operation": { "const": "formal_evaluation" } },
				"required": ["operation"]
			},
			"then": {
				"properties": {
					"subject": {
						"required": [
							"bundle_manifest_path",
							"bundle_digest",
							"runtime_identity_digest",
							"inference_protocol_digest",
							"dataset_identity_digest",
							"scoring_protocol_digest"
						]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"runtime_requirements": {
						"type": "object",
						"properties": { "executor_kind": { "const": "docker" } },
						"required": ["executor_kind"]
					}
				},
				"required": ["runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"required": ["executor_kind", "docker_image", "docker_mounts"],
						"properties": {
							"docker_image": { "type": "string", "minLength": 1 },
							"docker_mounts": { "type": "array", "items": { "$ref": "#/$defs/dockerMount" } },
							"docker_env": { "type": "object", "additionalProperties": { "type": "string" } },
							"docker_workdir": { "$ref": "#/$defs/absolutePath" },
							"docker_network": { "type": "string", "minLength": 1 },
							"docker_image_digest": { "$ref": "#/$defs/digest" }
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"operation": { "const": "formal_evaluation" },
					"runtime_requirements": {
						"type": "object",
						"properties": { "executor_kind": { "const": "docker" } },
						"required": ["executor_kind"]
					}
				},
				"required": ["operation", "runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"required": ["docker_image_digest"],
						"properties": {
							"docker_image": { "pattern": "@sha256:[a-f0-9]{64}$" },
							"docker_image_digest": { "$ref": "#/$defs/digest" }
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"runtime_requirements": {
						"type": "object",
						"required": ["execution_surface"],
						"properties": { "execution_surface": { "type": "string" } }
					}
				},
				"required": ["runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"properties": {
							"execution_surface": { "enum": ["vc", "remote", "trusted"] }
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"runtime_requirements": {
						"type": "object",
						"required": ["execution_surface"],
						"properties": { "execution_surface": { "const": "vc" } }
					}
				},
				"required": ["runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"required": ["executor_kind", "vc_project", "vc_partition"],
						"properties": {
							"executor_kind": { "enum": ["remote", "trusted"] },
							"vc_project": { "type": "string", "minLength": 1 },
							"vc_partition": { "type": "string", "minLength": 1 },
							"vc_gpus": { "type": "integer", "minimum": 1 },
							"vc_memory_gb": { "type": "integer", "minimum": 1 },
							"vc_cpus": { "type": "integer", "minimum": 1 }
						}
					}
				}
			}
		},
		{
			"if": {
			"properties": {
				"runtime_requirements": {
					"type": "object",
					"required": ["execution_surface"],
					"properties": { "execution_surface": { "const": "remote" } }
				}
			},
			"required": ["runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"required": ["executor_kind"],
						"properties": { "executor_kind": { "const": "remote" } }
					}
				}
			}
		},
		{
			"if": {
			"properties": {
				"runtime_requirements": {
					"type": "object",
					"required": ["execution_surface"],
					"properties": { "execution_surface": { "const": "trusted" } }
				}
			},
			"required": ["runtime_requirements"]
			},
			"then": {
				"properties": {
					"runtime_requirements": {
						"required": ["executor_kind"],
						"properties": { "executor_kind": { "const": "trusted" } }
					}
				}
			}
		}
	],
	"$defs": {
		"id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
		"digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
		"absolutePath": { "type": "string", "pattern": "^/" },
		"jsonValue": {
			"oneOf": [
				{ "type": ["string", "number", "boolean", "null"] },
				{ "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
				{ "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
			]
		},
		"dockerMount": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source", "target", "read_only"],
			"properties": {
				"source": { "$ref": "#/$defs/absolutePath" },
				"target": { "$ref": "#/$defs/absolutePath" },
				"read_only": { "type": "boolean" }
			}
		},
		"requirement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["capability_id", "capability_class", "required"],
			"properties": {
				"capability_id": { "type": "string", "pattern": "^sure\\.[a-z0-9][a-z0-9.-]*$" },
				"capability_class": { "enum": ["agent_capability", "execution_capability"] },
				"required": { "type": "boolean" },
				"constraints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
			}
		},
		"artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["artifact_id", "path", "resolved_path", "sha256", "size", "media_type", "origin", "source_root"],
			"properties": {
				"artifact_id": { "$ref": "#/$defs/id" },
				"path": { "$ref": "#/$defs/absolutePath" },
				"resolved_path": { "$ref": "#/$defs/absolutePath" },
				"sha256": { "$ref": "#/$defs/digest" },
				"size": { "type": "integer", "minimum": 0 },
				"media_type": { "type": "string", "minLength": 1 },
				"origin": { "enum": ["local_staging", "read_only_reference", "generated", "external"] },
				"source_root": { "$ref": "#/$defs/absolutePath" },
				"reference_snapshot_digest": { "$ref": "#/$defs/digest" },
				"kind": { "enum": ["file", "directory"] },
				"digest_kind": { "enum": ["file_sha256", "tree_sha256"] }
			},
			"allOf": [
				{
					"if": { "properties": { "origin": { "const": "read_only_reference" } }, "required": ["origin"] },
					"then": { "required": ["reference_snapshot_digest"] }
				},
				{
					"if": { "properties": { "kind": { "const": "directory" } }, "required": ["kind"] },
					"then": {
						"required": ["digest_kind"],
						"properties": { "digest_kind": { "const": "tree_sha256" }, "media_type": { "const": "inode/directory" } }
					}
				},
				{
					"if": { "properties": { "digest_kind": { "const": "tree_sha256" } }, "required": ["digest_kind"] },
					"then": { "properties": { "kind": { "const": "directory" } }, "required": ["kind"] }
				}
			]
		},
		"inputBinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "contract_digest", "selector_id", "context_artifact", "context_digest", "inputs", "binding_digest"],
			"properties": {
				"schema": { "const": "sure.execution_input_binding.v1" },
				"contract_digest": { "$ref": "#/$defs/digest" },
				"selector_id": { "$ref": "#/$defs/id" },
				"context_artifact": { "$ref": "#/$defs/relativePath" },
				"context_digest": { "$ref": "#/$defs/digest" },
				"inputs": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/inputBindingEntry"
					}
				},
				"binding_digest": { "$ref": "#/$defs/digest" }
			}
		},
		"field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
		"inputBindingEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["input_id", "locator_kind", "path", "artifact"],
			"properties": {
				"input_id": { "$ref": "#/$defs/id" },
				"locator_kind": { "enum": ["run_artifact", "run_path", "resolved_input_field"] },
				"path": { "type": "string", "minLength": 1 },
				"artifact": { "$ref": "#/$defs/artifact" }
			},
			"allOf": [
				{
					"if": { "properties": { "locator_kind": { "const": "resolved_input_field" } }, "required": ["locator_kind"] },
					"then": { "properties": { "path": { "$ref": "#/$defs/field" } } }
				},
				{
					"if": {
						"properties": { "locator_kind": { "enum": ["run_artifact", "run_path"] } },
						"required": ["locator_kind"]
					},
					"then": { "properties": { "path": { "$ref": "#/$defs/relativePath" } } }
				}
			]
		},
		"outputSpec": {
			"type": "object",
			"additionalProperties": false,
			"required": ["artifact_id", "path", "kind", "required"],
			"properties": {
				"artifact_id": { "$ref": "#/$defs/id" },
				"path": { "$ref": "#/$defs/relativePath" },
				"kind": { "enum": ["file", "directory"] },
				"required": { "type": "boolean" }
			}
		},
		"outputContract": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "mode", "outputs", "temporary_paths", "allow_missing_on_failure", "retain_failed_outputs"],
			"properties": {
				"schema": { "const": "sure.execution_output_contract.v1" },
				"mode": { "enum": ["preexisting", "mutating", "producing"] },
				"outputs": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/outputSpec" }
				},
				"temporary_paths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
				"allow_missing_on_failure": { "type": "boolean" },
				"retain_failed_outputs": { "type": "boolean" }
			},
			"allOf": [
				{
					"if": { "properties": { "mode": { "const": "producing" } }, "required": ["mode"] },
					"then": { "properties": { "outputs": { "contains": { "properties": { "required": { "const": true } }, "required": ["required"] } } } }
				}
			]
		},
		"relativePath": {
			"type": "string",
			"minLength": 1,
			"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+"
		},
		"outputRoot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "resolved_path", "scope_id", "policy_digest", "writable"],
			"properties": {
				"path": { "$ref": "#/$defs/absolutePath" },
				"resolved_path": { "$ref": "#/$defs/absolutePath" },
				"scope_id": { "$ref": "#/$defs/id" },
				"policy_digest": { "$ref": "#/$defs/digest" },
				"writable": { "const": true }
			}
		}
	}
}
