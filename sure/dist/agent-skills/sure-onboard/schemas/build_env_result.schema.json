{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "build_env_result.schema.json",
	"title": "SURE model-tool build env result",
	"description": "Structured output of the BUILD_ENV unit.",
	"type": "object",
	"required": ["env_ready"],
	"properties": {
		"env_ready": { "type": "boolean" },
		"model_id": { "type": "string" },
		"model_name": { "type": "string" },
		"backend": { "type": "string" },
		"installer": { "type": "string" },
		"python_version": { "type": "string" },
		"python_executable": { "type": "string" },
		"model_dir": { "type": "string" },
		"artifacts_dir": { "type": "string" },
		"lockfile_path": { "type": ["string", "null"] },
		"docker_image": { "type": ["string", "null"] },
		"duration_seconds": { "type": "number" },
		"log_path": { "type": "string" },
		"runtime_checks": {
			"type": "object",
			"properties": {
				"required_imports": {
					"type": "array",
					"items": { "type": "string" }
				},
				"require_cuda": { "type": "boolean" }
			},
			"additionalProperties": true
		},
		"runtime_probe": {
			"type": "object",
			"properties": {
				"status": { "type": "string" },
				"python_executable": { "type": "string" },
				"python_version": { "type": "string" },
				"imports": { "type": "object" },
				"torch": { "type": "object" },
				"error": { "type": "string" }
			},
			"additionalProperties": true
		},
		"model_runtime": {
			"type": "object",
			"required": ["schema", "runtime_id", "backend", "python_executable", "manifest_sha256", "lock_sha256"],
			"properties": {
				"schema": { "const": "sure.model.runtime.manifest.v1" },
				"runtime_id": { "type": "string", "pattern": "^sure-model-python-v1-[0-9a-f]{24}$" },
				"backend": { "const": "uv" },
				"python_executable": { "const": "bin/python" },
				"manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
			},
			"additionalProperties": false
		},
		"repairs": {
			"type": "array",
			"items": {
				"type": ["object", "string"]
			}
		},
		"failures": { "type": "array", "items": { "type": "string" } },
		"notes": { "type": "string" }
	},
	"additionalProperties": false
}
