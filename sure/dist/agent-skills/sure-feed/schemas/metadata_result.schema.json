{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "metadata_result.schema.json",
	"title": "SURE model-feed metadata",
	"description": "Structured output of the COLLECT_METADATA unit.",
	"type": "object",
	"required": ["models"],
	"properties": {
		"models": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["model_id"],
				"properties": {
					"model_id": { "type": "string" },
					"source": { "type": "string", "enum": ["modelscope", "huggingface", "github", "multi"] },
					"repo": { "type": "string" },
					"source_url": { "type": "string" },
					"weights_source": { "type": ["string", "null"] },
					"license": { "type": ["string", "null"] },
					"frameworks": { "type": "array", "items": { "type": "string" } },
					"entrypoint_hints": { "type": "object" },
					"environment_hints": { "type": "object" },
					"metadata_summary": { "type": "string" }
				},
				"additionalProperties": true
			}
		}
	},
	"additionalProperties": false
}
