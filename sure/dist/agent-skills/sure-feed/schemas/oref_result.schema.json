{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "oref_result.schema.json",
	"title": "SURE model-feed oref conversion",
	"description": "Structured output of the CONVERT_TO_OREF unit.",
	"type": "object",
	"required": ["converted"],
	"properties": {
		"converted": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["model_id", "oref_path"],
				"properties": {
					"model_id": { "type": "string" },
					"oref_path": { "type": "string" },
					"weights_path": { "type": ["string", "null"] }
				},
				"additionalProperties": true
			}
		}
	},
	"additionalProperties": false
}
