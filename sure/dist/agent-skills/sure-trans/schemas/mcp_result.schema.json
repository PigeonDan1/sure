{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool_name",
    "run_command"
  ],
  "properties": {
    "status": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "tool_name": {
      "type": "string"
    },
    "run_command": {
      "type": [
        "array",
        "string"
      ]
    },
    "protocol_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "env": {
      "type": "object"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1
    },
    "mcp_passed": {
      "type": "boolean"
    },
    "executed": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "number"
    },
    "log_path": {
      "type": "string"
    },
    "selected_device": {
      "enum": [
        "cuda",
        "cpu"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
