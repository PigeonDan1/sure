{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sure.example/contracts/evaluation-subject.v1.schema.json",
	"title": "SURE frozen evaluation subject",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"subject_id",
		"bundle_manifest_path",
		"bundle_digest",
		"runtime_identity_digest",
		"inference_protocol_digest",
		"dataset_identity_digest",
		"scoring_protocol_digest",
		"prediction_path",
		"prediction_digest",
		"execution_receipt_digest",
		"evaluator_engine_digest",
		"evaluator_route_digest",
		"workflow_digest",
		"validator_digest",
		"executor_digest",
		"policy_digest",
		"reference_snapshot_digest",
		"assurance_profile",
		"legacy_unverified",
		"frozen_at",
		"subject_digest"
	],
	"properties": {
		"schema": { "const": "sure.evaluation_subject.v1" },
		"subject_id": { "$ref": "#/$defs/id" },
		"bundle_manifest_path": { "$ref": "#/$defs/absolutePath" },
		"bundle_digest": { "$ref": "#/$defs/digest" },
		"runtime_identity_digest": { "$ref": "#/$defs/digest" },
		"inference_protocol_digest": { "$ref": "#/$defs/digest" },
		"dataset_identity_digest": { "$ref": "#/$defs/digest" },
		"scoring_protocol_digest": { "$ref": "#/$defs/digest" },
		"prediction_path": { "$ref": "#/$defs/absolutePath" },
		"prediction_digest": { "$ref": "#/$defs/digest" },
		"execution_receipt_digest": { "$ref": "#/$defs/digest" },
		"evaluator_engine_digest": { "$ref": "#/$defs/digest" },
		"evaluator_route_digest": { "$ref": "#/$defs/digest" },
		"workflow_digest": { "$ref": "#/$defs/digest" },
		"validator_digest": { "$ref": "#/$defs/digest" },
		"executor_digest": { "$ref": "#/$defs/digest" },
		"policy_digest": { "$ref": "#/$defs/digest" },
		"reference_snapshot_digest": { "$ref": "#/$defs/digest" },
		"assurance_profile": { "enum": ["cooperative", "pi_enforced", "trusted"] },
		"legacy_unverified": { "type": "boolean" },
		"approval_event_digest": { "$ref": "#/$defs/digest" },
		"frozen_at": { "type": "string", "format": "date-time" },
		"subject_digest": { "$ref": "#/$defs/digest" }
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
		"digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
		"absolutePath": { "type": "string", "pattern": "^/" }
	}
}
