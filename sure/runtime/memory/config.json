{
  "schema": "sure.memory.config.v1",
  "promote_useful_activated": 2,
  "promote_min_distinct_runs": 2,
  "demote_disputed_streak": 2,
  "max_candidates_per_run": 5,
  "max_triggers_per_candidate": 5,
  "bad_case_max_words": 200,
  "fact_max_words": 60,
  "proposal_md_max_bytes": 65536,
  "trigger_min_chars": 8,
  "evidence_max_bytes": 33554432,
  "trigger_stopwords": ["error", "failed", "failure", "exception", "warning", "missing", "invalid", "cuda", "timeout", "not found"],
  "trigger_template_phrases": [
    "under the run artifacts directory before advancing from unit",
    "is missing required field",
    "Full expected shape:",
    "Expected shape:",
    "must be a JSON object",
    "must be one of",
    "must not contain field",
    "contains undeclared field(s)",
    "remains blocked on unchanged artifact content",
    "Blocked because:",
    "consecutive blocked attempts",
    "Gate script scripts/",
    "is not permitted from unit",
    "Only the current unit's owned scripts may run here"
  ],
  "target_skills": ["sure_onboard", "sure_eval", "sure_feed", "sure_reval", "_shared"],
  "cause_enum": [
    "python_dependency_missing", "system_dependency_missing", "cuda_version_mismatch", "wrong_python_version",
    "missing_weights", "wrong_entrypoint", "config_not_set", "runtime_backend_incompatible",
    "infra", "job_submission", "resource_limit", "data_layout", "result_layout", "metric_bypass", "n.a."
  ],
  "fact_scopes": ["cluster", "model_family", "dataset"],
  "extraction_gate_max_failures": 2,
  "finish_extraction_max_attempts": 2,
  "inject_max_entries": 2,
  "inject_max_chars_per_entry": 300,
  "inject_max_chars_total": 1500,
  "inject_header": "Memory (advisory, agent-written, not human-reviewed; verify against evidence before relying):",
  "memory_context_max_provisional": 10,
  "digest_max_bytes": 20480,
  "digest_limits": {
    "repair_head_chars": 200, "repair_tail_chars": 400,
    "fix_window_commands": 10, "command_chars": 300, "last_commands": 10,
    "log_tail_lines": 30, "log_line_chars": 300, "log_seek_bytes": 65536,
    "prior_runs": 5, "prior_run_repair_chars": 300
  },
  "digest_trim_order": ["index_snapshot_min", "registry_current_only", "prior_runs_2", "log_tail_10", "repairs_300", "fix_window_5"],
  "index_md_max_lines": 200,
  "index_md_max_bytes": 25600,
  "stale_after_days": {"cluster": 90, "model_family": 180, "dataset": 180},
  "usage_max_line_bytes": 4096,
  "gate_digest_max_entries": 2000,
  "gate_digest_max_bytes": 8388608,
  "publish_timeout_ms": 60000,
  "index_check_timeout_ms": 30000,
  "dedup_jaccard_min": 0.5,
  "dedup_ratio_min": 0.9
}
