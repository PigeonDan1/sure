    "validate_infer": ["artifact:infer_result.json", "{run_dir}/artifacts/infer_execution.log", "{product_dir}/artifacts/validation.log"],
    "validate_contract": ["artifact:contract_result.json", "{run_dir}/artifacts/contract_execution.log", "{product_dir}/artifacts/validation.log"]
  },
  "sure_trans": {
