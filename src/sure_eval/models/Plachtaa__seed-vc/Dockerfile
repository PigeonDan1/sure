COPY src/sure_eval/models/Plachtaa__seed-vc/artifacts/weights_manifest.json ./src/sure_eval/models/Plachtaa__seed-vc/artifacts/weights_manifest.json

RUN mkdir -p "${MODEL_DIR}/.runtime" "${MODEL_DIR}/checkpoints" "${MODEL_DIR}/artifacts/outputs" \
    && chmod -R a+rwx "${SURE_EVAL_ROOT}"

