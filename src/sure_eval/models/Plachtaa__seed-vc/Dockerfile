# Generated by xforge_sure_bridge for SURE model onboarding.
# Runtime weights and caches are intentionally not copied into the image.
ARG BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SURE_EVAL_ROOT=/workspace/sure-eval \
    MODEL_DIR=/workspace/sure-eval/src/sure_eval/models/Plachtaa__seed-vc \
    HF_HOME=/workspace/sure-eval/src/sure_eval/models/Plachtaa__seed-vc/.runtime/huggingface \
    HF_HUB_CACHE=/workspace/sure-eval/src/sure_eval/models/Plachtaa__seed-vc/.runtime/huggingface/hub \
    HF_HUB_DISABLE_XET=1 \
    XDG_CACHE_HOME=/workspace/sure-eval/src/sure_eval/models/Plachtaa__seed-vc/.runtime/cache \
    MPLCONFIGDIR=/workspace/sure-eval/src/sure_eval/models/Plachtaa__seed-vc/.runtime/matplotlib \
    DEVICE=cuda \
    DIFFUSION_STEPS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libsndfile1 \
        wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/sure-eval

COPY src/sure_eval/models/Plachtaa__seed-vc/requirements-docker.txt /tmp/seed_vc_requirements_docker.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r /tmp/seed_vc_requirements_docker.txt

COPY src/sure_eval/__init__.py ./src/sure_eval/__init__.py
COPY src/sure_eval/models/__init__.py ./src/sure_eval/models/__init__.py
COPY src/sure_eval/models/Plachtaa__seed-vc/__init__.py ./src/sure_eval/models/Plachtaa__seed-vc/__init__.py
COPY src/sure_eval/models/Plachtaa__seed-vc/model.py ./src/sure_eval/models/Plachtaa__seed-vc/model.py
COPY src/sure_eval/models/Plachtaa__seed-vc/server.py ./src/sure_eval/models/Plachtaa__seed-vc/server.py
COPY src/sure_eval/models/Plachtaa__seed-vc/validate.py ./src/sure_eval/models/Plachtaa__seed-vc/validate.py
COPY src/sure_eval/models/Plachtaa__seed-vc/config.yaml ./src/sure_eval/models/Plachtaa__seed-vc/config.yaml
COPY src/sure_eval/models/Plachtaa__seed-vc/model.spec.yaml ./src/sure_eval/models/Plachtaa__seed-vc/model.spec.yaml
