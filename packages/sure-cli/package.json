{
	"name": "@earendil-works/sure-cli",
	"version": "0.80.3",
	"description": "Host-neutral SURE Core command line control plane",
	"type": "module",
	"bin": {
		"surectl": "dist/surectl.js"
	},
	"main": "./dist/surectl.js",
	"types": "./dist/surectl.d.ts",
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/surectl.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/sure-core": "0.80.3",
		"proper-lockfile": "4.1.2"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {"node": ">=22.19.0"},
	"license": "MIT"
}
