{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@earendil-works/sure-core": ["../sure-core/dist/index.d.ts"],
			"@earendil-works/sure-core/node": ["../sure-core/dist/node/index.d.ts"],
			"@earendil-works/sure-core/*": [
				"../sure-core/dist/*.d.ts",
				"../sure-core/dist/conformance/*.d.ts",
				"../sure-core/dist/contracts/*.d.ts",
				"../sure-core/dist/execution/*.d.ts",
				"../sure-core/dist/evaluation/*.d.ts",
				"../sure-core/dist/policy/*.d.ts",
				"../sure-core/dist/run/*.d.ts",
				"../sure-core/dist/validation/*.d.ts",
				"../sure-core/dist/workflow/*.d.ts"
			]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts"]
}
